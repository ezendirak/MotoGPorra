# Un único .gitignore para todo el monorepo: los .gitignore anidados
# tienen prioridad sobre este y ya nos costaron perder .env.example.

# --- Node / Next.js ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel/

# --- Entorno: nunca subir secretos ---
.env
.env.*
!.env.example
*.pem

# --- Python (packages/motogp_client, apps/sync) ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Supabase ---
supabase/.branches/
supabase/.temp/

# --- Herramientas locales ---
.claude/settings.local.json

# --- Sistema y editores ---
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json
