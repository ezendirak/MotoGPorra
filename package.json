{
  "name": "motogporra",
  "version": "0.1.0",
  "private": true,
  "description": "Porra anual de MotoGP — PWA Mobile First",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=web",
    "format": "npm run format --workspace=web",
    "format:check": "npm run format:check --workspace=web",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "db:push": "supabase db push --linked",
    "db:diff": "supabase migration list --linked",
    "db:verify": "node supabase/tests/verify-phase1.mjs"
  },
  "devDependencies": {
    "supabase": "2.111.0"
  }
}
