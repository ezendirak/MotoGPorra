# ---------------------------------------------------------------------------
# Copia este fichero a .env.local y rellena los valores.
# .env.local NUNCA se sube al repositorio.
# ---------------------------------------------------------------------------

# --- Públicas (se inlinean en el bundle de cliente: aquí no van secretos) ---

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Clave anónima. Es pública por diseño: la protección real es RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# URL base de la app. En local, http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Secretas (sólo servidor; nunca con prefijo NEXT_PUBLIC_) ---

# Bypassa RLS por completo. Sólo la usan lib/supabase/admin.ts y apps/sync.
SUPABASE_SERVICE_ROLE_KEY=""

# Opcionales: disparo manual de la sincronización desde el panel de admin.
# Token fine-grained de GitHub con permiso `actions: write` sobre este repo.
GITHUB_SYNC_TOKEN=""
GITHUB_SYNC_REPO="owner/MotoGPorra"
